{
  // Fleet governance policy — structural caps enforced BEFORE any provisioning,
  // fail-closed. Non-secret, so it is committed and version-controlled: the policy
  // itself is the reviewable governance artifact. `fleetctl up --go` enforces this
  // today; the Aegis panel will enforce the same file once panel-driven provisioning
  // lands. Edit the numbers here to change the caps.

  "maxFleet": 6,                   // hard ceiling on total registered agents

  // Agents that decommission MUST refuse to tear down. Changing this list is an
  // attested policy.set (value = comma-separated names, or `none` to clear); the
  // set also syncs an Azure CanNotDelete lock onto each protected rg-<name>.
  // THIS IS THE ONLY POLICY FILE. The plane used to read its own untracked copy via
  // $AEGIS_POLICY, which meant the panel and the CLI could answer differently about the same
  // fact -- and did: an agent showed unprotected in the panel while decommission would have
  // refused. The plane now reads this file from its own checkout, so `Update plane` is the
  // reconcile and a policy change on origin shows as UPDATE PENDING rather than sitting
  // invisible. The panel can REQUEST a protection change; only `fleetctl policy set` plus a
  // commit decides one.
  "protectedAgents": [],
  // Agent-to-agent relay allowlist -- DIRECTED pairs "from>to". Empty means no relay
  // is possible; the capability does not exist until an operator attests a pair.
  // Aegis is always the mediator: no agent has a network path to another.
  "a2aPairs": [],
  // telegramChatIds is deliberately NOT a key here. It is a per-installation identifier and
  // this file is committed, so listing it would put a chat id in git. It lives in the plane's
  // aegis.config.json; `policy set telegramChatIds` refuses with that redirect rather than
  // failing as an unknown key. The allowlist semantics are unchanged -- empty ignores everyone.
  "maxBatch": 2,                   // most agents a single provisioning request may create
  "allowedRegions": ["eastus2","northcentralus"],   // agents may ONLY be stood up in these Azure regions
  "defaultRegion": "eastus2",      // region offered by the panel when a request omits one

  // Declared monthly budget (USD), enforced against ACTUAL spend read from the
  // Azure Cost Management budget named below (create it once — see the runbook).
  // up --go blocks if month-to-date spend already meets/exceeds this; if the budget
  // can't be read it warns and relies on maxFleet. The fleet deallocates between
  // sessions, so this actual-spend gate is the meaningful budget control; maxFleet
  // is the structural bound on agent count.
  "maxMonthlyBudgetUsd": 150,
  "budgetName": "fleet-monthly"
}
